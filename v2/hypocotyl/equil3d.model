# 3D apical hook: the hypocotyl epidermis as a closed, turgid,
# center-triangulated TRBS shell (Walia, Carter et al. 2024, the toroidal
# pressure vessel made cell-resolved).
#
# Mechanism: uniform turgor pressurizes the shell; TRBS gives the wall proper
# 2D elasticity (Young + Poisson) so hoop and longitudinal stresses follow the
# toroid solution (higher hoop stress on the inner side, uniform longitudinal
# stress, net Bourdon moment). Walls yield irreversibly when strained beyond a
# threshold (Lockhart), saturating at a maximal length: the outer hook side is
# born near-saturated, the inner side is short. Auxin (high inner in dark)
# represses growth; illumination at t=0 depletes it, the inner side extends
# longitudinally and the hook opens.
#
# units: um, hours
8 0 0

CenterTriangulation::Initiate 0 1 1
12      # CT data appended after the 12 cell variables

VertexFromTRBScenterTriangulation 3 3 1 1 1
2000.0  # Y_mod: MATRIX modulus Y_m (pectin/hemicellulose, isotropic). The
        #   fiber part Y_f is added by WallMechanics::FiberSpring below.
        #   Calibrated so the effective fiber:matrix stiffness ratio is the
        #   paper's Y_m:Y_f = 75:100 (see calib.py). Y,P scaled x25 so the
        #   overdamped arm rotation reaches biological rates.
0.3     # P_ratio (Poisson)
0.02    # stress-state refresh interval (h): CMT reorientation is an
        #   hours-scale process, so refreshing the material every 0.02 h is
        #   far finer than the biology and ~40x cheaper than every step
0       # wall length index
12      # CT start index
7       # store cell stress state [aniso, dir xyz, sigma1] at vars 7-11

WallMechanics::FiberSpring 3 2 1 1
135.0   # Y_fiber: CMT-guided cellulose stiffness (per unit transverse wall
        #   width), redistributed between the principal stress directions by
        #   Eq. 3 of Walia et al. (2024). Isotropic limit (a=0): both
        #   directions get Y_f/2; full anisotropy (a=1): all of it along the
        #   maximal stress direction, none perpendicular (2.3x ratio).
0.7     # K_hill (paper: k = 0.7)
1.2     # n_hill (paper: n = 1.2)
0       # wall length index
7       # cell stress-state start index

Pressure3D::CenterTriangulation 1 1 1
1.75    # P_force (turgor per unit shell area)
12      # CT start index

WallGrowth::StrainSaturationHill 6 3 1 1 1
0.0    # k_growth: frozen for equilibration
0.005   # strain_threshold (yield strain)
40.0    # L_max (um): cell length saturation (outer hook cells born near max)
0.3     # K_Hill (auxin repression threshold)
6       # n_Hill
0       # hill_flag: repressing
0       # wall length index
4       # cell variable: auxin
1       # wall variable: growFlag (axial walls only)

CenterTriangulation::WallGrowth::StrainSaturationHill 6 2 1 1
0.0    # k_growth: frozen for equilibration
0.005   # strain_threshold
30.0    # L_max (um) for internal edges
0.3     # K_Hill
6       # n_Hill
0       # hill_flag: repressing
12      # CT start index
4       # cell variable: auxin

Degradation::One 1 1 1
0.0     # k_d: dark
4       # cell variable: auxin

VertexNoUpdateFromIndex 0 1 12
# Clamp the APICAL end-cap ring (ring 29, the cotyledon end). The hook then
# unrolls about the apex and the basal shank swings out to become the
# straight vertical axis, rather than the apex swinging about a fixed base.
348 349 350 351 352 353 354 355 356 357 358 359
