# 3D apical hook: the hypocotyl epidermis as a closed, turgid,
# center-triangulated TRBS shell (Walia, Carter et al. 2024, the toroidal
# pressure vessel made cell-resolved).
#
# Mechanism: uniform turgor pressurizes the shell; TRBS gives the wall proper
# 2D elasticity (Young + Poisson) so hoop and longitudinal stresses follow the
# toroid solution (higher hoop stress on the inner side, uniform longitudinal
# stress, net Bourdon moment). Walls yield irreversibly when strained beyond a
# threshold (Lockhart), saturating at a maximal length: the outer hook side is
# born near-saturated, the inner side is short. Auxin (high inner in dark)
# represses growth; illumination at t=0 depletes it, the inner side extends
# longitudinally and the hook opens.
#
# units: um, hours
6 0 0

CenterTriangulation::Initiate 0 1 1
7       # CT data (center + internal edge lengths) appended after 7 cell vars

VertexFromTRBScenterTriangulation 2 2 1 1
100.0   # Y_mod (2D Young modulus of the wall; elastic strains held just
        #   above yield so shape follows the grown rest geometry)
0.3     # P_ratio (Poisson)
0       # wall length index
7       # CT start index

Pressure3D::CenterTriangulation 1 1 1
0.07    # P_force (turgor per unit shell area)
7       # CT start index

WallGrowth::StrainSaturationHill 6 3 1 1 1
20.0    # k_growth (1/h per unit strain): Lockhart wall yielding
0.005   # strain_threshold (yield strain)
40.0    # L_max (um): cell length saturation (outer hook cells born near max)
0.3     # K_Hill (auxin repression threshold)
6       # n_Hill
0       # hill_flag: repressing
0       # wall length index
4       # cell variable: auxin
1       # wall variable: growFlag (axial walls only)

CenterTriangulation::WallGrowth::StrainSaturationHill 6 2 1 1
20.0    # k_growth: internal edges follow the same yielding law
0.005   # strain_threshold
30.0    # L_max (um) for internal edges
0.3     # K_Hill
6       # n_Hill
0       # hill_flag: repressing
7       # CT start index
4       # cell variable: auxin

Degradation::One 1 1 1
0.9     # k_d: light-triggered auxin depletion (t=0 = illumination)
4       # cell variable: auxin
