# Apical hook opening model (2D median longitudinal section)
#
# Mechanism after Walia, Carter et al. (2024) Dev Cell 59:3245-3258:
#  - uniform turgor pressure loads the tissue; the thick outer epidermal
#    walls are the main growth constraint (stiffer springs, stiffFlag)
#  - walls extend irreversibly when elastic strain exceeds a threshold
#    (Lockhart / Bozorg et al. 2016), saturating at a maximal length
#  - auxin (high on the inner hook side in darkness) represses growth via a
#    Hill function; illumination at t=0 triggers auxin depletion
#  - subepidermal cells (low auxin) elongate first, pushing the epidermis
#    (the paper's "subepidermal longitudinal force" emerges from geometry)
# Opening = differential inner-side extension; outer cells are near their
# maximal length and extend minimally.
#
# units: um, hours
10 0 0

Pressure2D::AreaPotential 2 0
18.0     # P_force (turgor, effective 2D)
0       # f_V_norm: constant pressure

WallMechanics::Spring 3 3 1 1 1
600.0   # K_force (wall elasticity)
1.0     # frac_adhesion (symmetric)
20000.0  # K_force2 for stiffFlag==1 walls (thick outer epidermal walls)
0       # wall length index
1       # wall variable: save spring force (visualization/analysis)
2       # wall variable: stiffness flag

WallGrowth::StrainSaturationHill 7 4 1 1 1 1
0.05    # k_growth (per tension unit per h)
2.0     # yield tension (Lockhart threshold, stress form)
40.0    # L_max (um): inner epidermal cells extend 3-4x (Walia et al. Fig 1)
0.3     # K_Hill (auxin repression threshold)
6       # n_Hill
0       # hill_flag: 0 = repressing (auxin inhibits growth)
2       # strain_flag: 2 = stress-driven (tension read from wall variable)
0       # wall length index
4       # cell variable: auxin
3       # wall variable: epiGrowFlag (epidermal longitudinal walls)
1       # wall variable: tension saved by WallMechanics::Spring

WallGrowth::StrainSaturationHill 7 3 1 1 1
0.15    # k_growth (1/h): active relative elongation rate
-0.04   # strain_threshold: gate; cells push until compression ~ turgor scale
100.0   # L_max (um): interior cells elongate like etiolated cortex
0.3     # K_Hill (auxin represses expansion)
6       # n_Hill
0       # hill_flag: repressing
0       # strain_flag: 0 = ACTIVE growth (subepidermal elongation engine,
        #   the time-increasing subepidermal force of Walia et al. 2024)
0       # wall length index
4       # cell variable: auxin
4       # wall variable: intGrowFlag (interior longitudinal walls)

Degradation::One 1 1 1
0.9     # k_d: light-triggered auxin depletion (t=0 = illumination)
4       # cell variable: auxin

CenterTriangulation::Initiate 0 1 1
7       # cell variables 0-6 exist; CT data appended from index 7

CenterTriangulation::EdgeSpring 2 1 1
80.0   # K_force: cell interior (soft; bending stiffness handles wrinkles)
1.0     # frac_adhesion
7       # CT start index

CenterTriangulation::EdgeRelaxation 1 1 1
6.0     # k_relax (1/h): interior is fluid on growth timescales
7       # CT start index

WallMechanics::BendingChain 1 1 1
150.0   # k_bend: wall plate bending stiffness (suppresses kinks/wrinkles)
5       # wall variable: bendFlag (longitudinal wall chains)

WallMechanics::Spring 3 3 1 0 1
0.0     # K_force zero: this reaction only adds transverse reinforcement
1.0     # frac_adhesion
1800.0  # K_force2: extra stiffness of transverse (radial) walls
0       # wall length index
6       # wall variable: transFlag
